VIGILIA_DB_HOST=localhost
VIGILIA_DB_PORT=5432
VIGILIA_DB_NAME=vigilia
VIGILIA_DB_USER=vigilia
VIGILIA_DB_PASSWORD=vigilia

VIGILIA_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
VIGILIA_ALERTS_RECEIVED_TOPIC=alerts.received.v1
VIGILIA_INVESTIGATIONS_REQUESTED_TOPIC=investigations.requested.v1
VIGILIA_KAFKA_FLUSH_TIMEOUT_SECONDS=5
VIGILIA_OUTBOX_BATCH_SIZE=100
VIGILIA_OUTBOX_POLL_INTERVAL_SECONDS=1
VIGILIA_OUTBOX_LOCK_SECONDS=60
VIGILIA_OUTBOX_MAX_RETRY_DELAY_SECONDS=300
VIGILIA_INCIDENT_CORRELATION_WINDOW_MINUTES=45
VIGILIA_INVESTIGATION_MAX_ATTEMPTS=3
VIGILIA_INVESTIGATION_RETRY_MAX_DELAY_SECONDS=60
VIGILIA_INVESTIGATION_LEASE_SECONDS=120
VIGILIA_WORKER_POLL_TIMEOUT_SECONDS=1

# Investigation analyzer. Keep "simulated" for local flows without API usage.
# Set "litellm" and choose any LiteLLM model identifier to use a real provider.
VIGILIA_INVESTIGATION_ANALYZER=simulated
# VIGILIA_LLM_MODEL=provider/model
# VIGILIA_LLM_API_KEY=
# VIGILIA_LLM_API_BASE=
VIGILIA_LLM_TIMEOUT_SECONDS=45
VIGILIA_LLM_MAX_OUTPUT_TOKENS=1200
VIGILIA_LLM_MAX_ALERTS=50

# RAG is disabled by default. Enable it with an embedding model supported by LiteLLM.
# The embedding model is independent from VIGILIA_LLM_MODEL.
VIGILIA_RAG_ENABLED=false
# VIGILIA_RAG_EMBEDDING_MODEL=provider/embedding-model
# VIGILIA_RAG_EMBEDDING_API_KEY=
# VIGILIA_RAG_EMBEDDING_API_BASE=
VIGILIA_RAG_EMBEDDING_TIMEOUT_SECONDS=30
VIGILIA_RAG_EMBEDDING_BATCH_SIZE=64
VIGILIA_RAG_CHUNK_SIZE=2400
VIGILIA_RAG_CHUNK_OVERLAP=300
VIGILIA_RAG_MAX_DOCUMENT_CHARACTERS=250000
VIGILIA_RAG_TOP_K=5
VIGILIA_RAG_MAX_CONTEXT_CHARACTERS=16000

# Provider-specific variables supported by LiteLLM can also be added here,
# for example ANTHROPIC_API_KEY, OPENAI_API_KEY or an Ollama API base.

# Webhook and incident API authentication. Replace both placeholders with
# strong, distinct secrets before using protected endpoints.
VIGILIA_GRAFANA_WEBHOOK_HMAC_SECRET=replace_with_a_strong_grafana_hmac_secret
VIGILIA_GRAFANA_WEBHOOK_MAX_AGE_SECONDS=300
VIGILIA_API_TOKEN=replace_with_a_strong_api_token

# Shared HTTP quotas and provider concurrency limits.
VIGILIA_REDIS_URL=redis://127.0.0.1:6379/0
VIGILIA_RATE_LIMIT_ENABLED=true
VIGILIA_RATE_LIMIT_INGRESS_PER_MINUTE=120
VIGILIA_RATE_LIMIT_API_PER_MINUTE=60
VIGILIA_RATE_LIMIT_INVESTIGATIONS_PER_MINUTE=5
VIGILIA_RATE_LIMIT_KNOWLEDGE_PER_MINUTE=2
VIGILIA_RATE_LIMIT_WEBHOOKS_PER_MINUTE=120
# Counts queued, running, and retry_wait jobs in PostgreSQL. Set 0 to disable.
VIGILIA_MAX_ACTIVE_INVESTIGATIONS=2
VIGILIA_PROVIDER_CALL_LIMITS_ENABLED=true
VIGILIA_LLM_MAX_CONCURRENT_CALLS=2
VIGILIA_RAG_EMBEDDING_MAX_CONCURRENT_CALLS=2
